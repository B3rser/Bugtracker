/***
 * Archivo de configuración de variables de entorno
 */

/***
 * MONGODB_URI: Define la URI de conexión a la base de datos MongoDB.

 * Está compuesta por varias partes con el siguiente formato:
 *   mongodb://dirServer:port/dbName
 * 
 * - mongodb://        → Protocolo usado para indicar que es una conexión a MongoDB.
 * - dirServer         → Host o dirección IP donde está corriendo el servidor de MongoDB.
 *                       Ejemplo: "localhost" si la base de datos se ejecuta localmente,
 *                       o "cluster0.abcd.mongodb.net" si usas MongoDB Atlas en la nube.
 * - port              → Puerto en el que escucha MongoDB (por defecto es 27017).
 * - dbName            → Nombre de la base de datos a la que la aplicación se conectará.
 *                       Ejemplo: "bugtracker"
 * 
 * Ejemplo completo:
 *   mongodb://localhost:27017/bugtracker
 */

MONGODB_URI="mongodb://localhost:27017/bugtracker"

/***
 * PORT: Define el puerto en el que el servidor de la API escuchará las peticiones HTTP.
 *
 * - Es el número que identifica el "canal" de comunicación por el cual la aplicación
 * se comunicará en la red local o en un servidor.
 * - Debe ser un número de puerto válido.
 * * Ejemplo de uso:
 * Si PORT=3000, la API será accesible localmente en http://localhost:3000 
 */
PORT=3000